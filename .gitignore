# ---------- Output reports ----------
output/*
!output/.gitkeep

# ---------- Secrets / credentials ----------
*.env
secrets.json
client_secret.txt
*.pfx
*.pem

# ---------- Logs / temp ----------
*.log
*.tmp
*.temp

# ---------- PowerShell ----------
*.ps1xml
!*.format.ps1xml

# ---------- VS Code ----------
.vscode/

# ---------- OS files ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Node (if you add tooling later) ----------
node_modules/

# Generated scenarios contain live tenant data
scenarios/generated/*.json
!scenarios/generated/.gitkeep

# Dashboard (contains live tenant data)
output/dashboard.html